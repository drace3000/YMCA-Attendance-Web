# ===========================================
# STAGING ENVIRONMENT (Supabase Cloud)
# ===========================================
# Copy this file to .env.local when testing against staging
# Get credentials from Supabase Dashboard > Project Settings > API
#
# To use: copy to .env.local or set APP_ENV=staging

# Staging Supabase Cloud Instance
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key

# OpenAI API Key (for NLQ feature)
OPENAI_API_KEY=your_openai_key