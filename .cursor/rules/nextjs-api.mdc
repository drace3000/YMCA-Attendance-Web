```

## Anti-Patterns to Avoid

```typescript
// ❌ Don't expose service role key in routes
import { createClient } from '@supabase/supabase-js'
const supabase = createClient(url, process.env.SUPABASE_SERVICE_ROLE_KEY!)

// ✅ Use server client that respects RLS
import { createClient } from '@/lib/supabase/server'
const supabase = await createClient()

// ❌ Don't return raw database errors to client
if (error) {
  return NextResponse.json({ error: error.message }, { status: 500 })
}

// ✅ Log internally, return generic message
if (error) {
  console.error('Database error:', error)
  return NextResponse.json({ error: 'Failed to fetch data' }, { status: 500 })
}

// ❌ Don't skip input validation
const { email } = await request.json()
await supabase.from('users').insert({ email })

// ✅ Always validate input
const result = schema.safeParse(await request.json())
if (!result.success) return errorResponse('Invalid input', 400)

// ❌ Don't use try/catch without proper error handling
try {
  // ...
} catch (e) {
  throw e  // Just re-throws, unhelpful
}

// ✅ Log and return appropriate response
try {
  // ...
} catch (error) {
  console.error('Unexpected error:', error)
  return errorResponse('Internal server error', 500)
}

// ❌ Don't forget to handle missing resources
const { data } = await supabase.from('users').select().eq('id', id).single()
return NextResponse.json(data)  // data could be null!

// ✅ Check for null/error
const { data, error } = await supabase.from('users').select().eq('id', id).single()
if (error || !data) {
  return errorResponse('User not found', 404)
}
return NextResponse.json(data)
```

## CORS (If Needed)

```typescript
// For public APIs that need CORS
export async function OPTIONS(request: NextRequest) {
  return new NextResponse(null, {
    status: 204,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    },
  })
}

// Add CORS headers to responses
const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
}

return NextResponse.json(data, { headers: corsHeaders })
```

## Rate Limiting Pattern

```typescript
import { Ratelimit } from '@upstash/ratelimit'
import { Redis } from '@upstash/redis'

const ratelimit = new Ratelimit({
  redis: Redis.fromEnv(),
  limiter: Ratelimit.slidingWindow(10, '10 s'), // 10 requests per 10 seconds
})

export async function POST(request: NextRequest) {
  const ip = request.ip ?? '127.0.0.1'
  const { success, limit, remaining } = await ratelimit.limit(ip)
  
  if (!success) {
    return NextResponse.json(
      { error: 'Too many requests' },
      { 
        status: 429,
        headers: {
          'X-RateLimit-Limit': limit.toString(),
          'X-RateLimit-Remaining': remaining.toString(),
        },
      }
    )
  }
  
  // Proceed with request...
}
```
