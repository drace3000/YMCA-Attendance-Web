## useFieldArray for Dynamic Fields

```tsx
import { useForm, useFieldArray } from 'react-hook-form'

const schema = z.object({
  classes: z.array(z.object({
    name: z.string().min(1),
    dayOfWeek: z.enum(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']),
    startTime: z.string(),
  })).min(1, 'Add at least one class'),
})

function ScheduleForm() {
  const { control, register, handleSubmit } = useForm({
    resolver: zodResolver(schema),
    defaultValues: {
      classes: [{ name: '', dayOfWeek: 'Mon', startTime: '' }],
    },
  })

  const { fields, append, remove } = useFieldArray({
    control,
    name: 'classes',
  })

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      {fields.map((field, index) => (
        <div key={field.id} className="flex gap-4">
          <input {...register(`classes.${index}.name`)} />
          <select {...register(`classes.${index}.dayOfWeek`)}>
            {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map(day => (
              <option key={day} value={day}>{day}</option>
            ))}
          </select>
          <input type="time" {...register(`classes.${index}.startTime`)} />
          <button type="button" onClick={() => remove(index)}>Remove</button>
        </div>
      ))}
      
      <button type="button" onClick={() => append({ name: '', dayOfWeek: 'Mon', startTime: '' })}>
        Add Class
      </button>
      
      <button type="submit">Save Schedule</button>
    </form>
  )
}
```

## Integration with React Query

```tsx
import { useMutation } from '@tanstack/react-query'

function InstructorForm({ onSuccess }: { onSuccess: () => void }) {
  const form = useForm<FormData>({
    resolver: zodResolver(instructorSchema),
  })

  const createInstructor = useMutation({
    mutationFn: (data: FormData) => 
      supabase.from('instructors').insert(data).select().single(),
    onSuccess: () => {
      form.reset()
      onSuccess()
    },
    onError: (error) => {
      form.setError('root', { message: error.message })
    },
  })

  return (
    <form onSubmit={form.handleSubmit((data) => createInstructor.mutate(data))}>
      {/* fields */}
      
      {form.formState.errors.root && (
        <div className="text-red-500">{form.formState.errors.root.message}</div>
      )}
      
      <button disabled={createInstructor.isPending}>
        {createInstructor.isPending ? 'Saving...' : 'Save'}
      </button>
    </form>
  )
}
```

## Form with Default Values from API

```tsx
function EditScheduleForm({ scheduleId }: { scheduleId: string }) {
  const { data: schedule, isLoading } = useSchedule(scheduleId)
  
  const form = useForm<FormData>({
    resolver: zodResolver(scheduleSchema),
    defaultValues: schedule, // Set when data loads
  })

  // Reset form when data loads
  useEffect(() => {
    if (schedule) {
      form.reset(schedule)
    }
  }, [schedule, form])

  if (isLoading) return <Spinner />

  return (
    <form onSubmit={form.handleSubmit(onSubmit)}>
      {/* fields */}
    </form>
  )
}
```

## Watch and Dependent Fields

```tsx
function ConditionalForm() {
  const { register, watch, control } = useForm()
  
  const watchRole = watch('role')
  const watchAll = watch() // Watch all fields

  return (
    <form>
      <select {...register('role')}>
        <option value="instructor">Instructor</option>
        <option value="manager">Manager</option>
      </select>

      {/* Show only for managers */}
      {watchRole === 'manager' && (
        <input {...register('branchId')} placeholder="Branch ID" />
      )}
    </form>
  )
}
```

## Form State Helpers

```tsx
const {
  formState: {
    errors,           // Field errors
    isSubmitting,     // Form is being submitted
    isValid,          // All fields valid
    isDirty,          // Any field changed
    dirtyFields,      // Which fields changed
    touchedFields,    // Which fields touched
  },
  reset,              // Reset to default values
  setValue,           // Set field value programmatically
  setError,           // Set error manually
  clearErrors,        // Clear errors
  trigger,            // Trigger validation
} = useForm()
```

## Anti-Patterns to Avoid

```tsx
// ❌ Don't use uncontrolled forms without validation
<form onSubmit={(e) => {
  e.preventDefault()
  const data = new FormData(e.target)
  // No validation!
}}>

// ✅ Use react-hook-form + zod
const { handleSubmit } = useForm({ resolver: zodResolver(schema) })
<form onSubmit={handleSubmit(onSubmit)}>

// ❌ Don't validate manually
const [errors, setErrors] = useState({})
if (!email.includes('@')) setErrors({ email: 'Invalid' })

// ✅ Let zod handle validation
const schema = z.object({ email: z.string().email() })

// ❌ Don't forget disabled state during submit
<button type="submit">Submit</button>

// ✅ Disable and show loading
<button disabled={isSubmitting}>
  {isSubmitting ? 'Submitting...' : 'Submit'}
</button>

// ❌ Don't use onChange for every field
const [name, setName] = useState('')
<input value={name} onChange={(e) => setName(e.target.value)} />

// ✅ Use register
<input {...register('name')} />
```

