# React Hook Form + Zod Rules

You are an expert in react-hook-form with zod validation. Use this combination for all forms - never uncontrolled forms with manual validation.

## Basic Setup

```tsx
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { z } from 'zod'

// 1. Define schema
const formSchema = z.object({
  email: z.string().email('Invalid email address'),
  password: z.string().min(8, 'Password must be at least 8 characters'),
})

// 2. Infer type from schema
type FormData = z.infer<typeof formSchema>

// 3. Use in component
function LoginForm() {
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<FormData>({
    resolver: zodResolver(formSchema),
  })

  const onSubmit = async (data: FormData) => {
    // data is fully typed and validated
    await login(data)
  }

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      <input {...register('email')} />
      {errors.email && <span>{errors.email.message}</span>}

      <input type="password" {...register('password')} />
      {errors.password && <span>{errors.password.message}</span>}

      <button type="submit" disabled={isSubmitting}>
        {isSubmitting ? 'Submitting...' : 'Submit'}
      </button>
    </form>
  )
}
```

## Zod Schema Patterns

### Basic Types
```tsx
const schema = z.object({
  // Strings
  name: z.string().min(1, 'Required'),
  email: z.string().email(),
  phone: z.string().regex(/^\d{10}$/, 'Must be 10 digits'),
  
  // Numbers
  age: z.coerce.number().min(0).max(120),  // coerce from string input
  quantity: z.coerce.number().int().positive(),
  
  // Booleans
  agreed: z.boolean().refine(val => val === true, 'Must agree to terms'),
  
  // Dates
  startDate: z.coerce.date(),
  
  // Enums
  status: z.enum(['active', 'inactive', 'pending']),
  
  // Optional fields
  nickname: z.string().optional(),
  bio: z.string().nullable(),
})
```

### Conditional Validation
```tsx
const schema = z.object({
  hasDiscount: z.boolean(),
  discountCode: z.string().optional(),
}).refine(
  (data) => !data.hasDiscount || data.discountCode,
  {
    message: 'Discount code required when discount is enabled',
    path: ['discountCode'],
  }
)
```

### Reusable Schema Parts
```tsx
// Common fields
const emailSchema = z.string().email('Invalid email')
const passwordSchema = z.string()
  .min(8, 'At least 8 characters')
  .regex(/[A-Z]/, 'Must contain uppercase')
  .regex(/[0-9]/, 'Must contain number')

// Compose schemas
const loginSchema = z.object({
  email: emailSchema,
  password: z.string().min(1, 'Required'),
})

const registerSchema = z.object({
  email: emailSchema,
  password: passwordSchema,
  confirmPassword: z.string(),
}).refine(data => data.password === data.confirmPassword, {
  message: 'Passwords must match',
  path: ['confirmPassword'],
})
```

### Array Fields
```tsx
const schema = z.object({
  instructors: z.array(
    z.object({
      id: z.string().uuid(),
      name: z.string().min(1),
      email: z.string().email(),
    })
  ).min(1, 'At least one instructor required'),
})
```

## Form Components with Tailwind

### Text Input
```tsx
interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {
  label: string
  error?: string
}

const Input = React.forwardRef<HTMLInputElement, InputProps>(
  ({ label, error, ...props }, ref) => (
    <div className="space-y-1">
      <label className="block text-sm font-medium text-gray-700">
        {label}
      </label>
      <input
        ref={ref}
        className={`
          w-full px-3 py-2 border rounded-lg
          focus:ring-2 focus:ring-blue-500 focus:border-transparent
          ${error ? 'border-red-500' : 'border-gray-300'}
        `}
        {...props}
      />
      {error && <p className="text-sm text-red-500">{error}</p>}
    </div>
  )
)

// Usage
<Input
  label="Email"
  {...register('email')}
  error={errors.email?.message}
/>
```

### Select Input
```tsx
interface SelectProps extends React.SelectHTMLAttributes<HTMLSelectElement> {
  label: string
  error?: string
  options: { value: string; label: string }[]
}

const Select = React.forwardRef<HTMLSelectElement, SelectProps>(
  ({ label, error, options, ...props }, ref) => (
    <div className="space-y-1">
      <label className="block text-sm font-medium text-gray-700">
        {label}
      </label>
      <select
        ref={ref}
        className={`
          w-full px-3 py-2 border rounded-lg
          focus:ring-2 focus:ring-blue-500 focus:border-transparent
          ${error ? 'border-red-500' : 'border-gray-300'}
        `}
        {...props}
      >
        <option value="">Select...</option>
        {options.map(opt => (
          <option key={opt.value} value={opt.value}>{opt.label}</option>
        ))}
      </select>
      {error && <p className="text-sm text-red-500">{error}</p>}
    </div>
  )
)
```

